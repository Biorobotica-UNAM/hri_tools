<launch>
    <group>
        <push_ros_namespace namespace="hri"/>

        <node pkg="human_detection" 
              exec="detector" 
              name="human_detector_node">
            <param name="image_topic" value="/head_rgbd_sensor/rgb/image_rect_color"/>

        </node> 
        
        <node pkg="human_detection" 
              exec="person_tracker" 
              name="person_tracker_node">
            <param name="enable_debug_markers" value="true"/>
            <param name="point_cloud_topic" value="/hardware/camera/points"/>
            <remap from="/human_detection/target_point" to="/hardware/head/look_at"/>
        </node>

    </group>
</launch>