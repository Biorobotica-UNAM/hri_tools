<launch>
    <!-- Declaramos el namespace -->
    <arg name="namespace" default="hri"/>

    <!-- TALKER -->
    <node
            pkg="talker"
            exec="talker"
            name="speech_talker"
            namespace="$(var namespace)"
            output="screen"/>

    <!-- LISTENER -->
    <node
            pkg="listener"
            exec="listener"
            name="speech_listener"
            namespace="$(var namespace)"
            output="screen"/>

</launch>
