<launch>

    <group>
        <push_ros_namespace namespace="hri"/>
        
        <arg name="use_takeshi" default="false"/>
        
        <!-- TALKER -->
        <include file="$(find-pkg-share talker)/launch/talker.launch.xml"
            unless="$(var use_takeshi)"/>

        <!-- LISTENER -->
        <include file="$(find-pkg-share listener)/launch/listener.launch.xml"/>

    </group>

</launch>

